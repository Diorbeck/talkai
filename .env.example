# Copy to .env (or run `npm run setup`) and fill in.
# .env is gitignored — never commit real secrets.

# Telegram MTProto app credentials — create one at https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# Saved session string, printed by `npm run login`. Leave blank until you log in.
TELEGRAM_SESSION=

# Google Gemini API key for the reply generator — get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: log level (trace|debug|info|warn|error). Defaults to info.
LOG_LEVEL=info
