# Copy to .env (or run `npm run setup`) and fill in.
# .env is gitignored — never commit real secrets.

# Control bot token from @BotFather (Telegram Business mode — recommended).
BOT_TOKEN=

# Google Gemini API key for the reply generator — get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: log level (trace|debug|info|warn|error). Defaults to info.
LOG_LEVEL=info

# --- Legacy MTProto mode only (npm run start:mtproto). Leave blank for the
# --- Telegram Business bot. Create an app at https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
